<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0D1322">
<title>Pembayaran · Charis Maulana</title>
<meta name="description" content="Informasi pembayaran Charis Maulana: QRIS, ShopeePay, dan transfer BNI.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#0D1322; --ink-2:#161E33; --line:rgba(255,255,255,.12);
  --paper:#F3F0EA; --paper-2:#E8E4DB; --text:#161B2A; --muted:#5E6577;
  --on-dark:#EEF0F6; --on-dark-muted:#9AA3BA;
  --shopee:#EE4D2D; --bni:#0B6E8A; --ok:#1F7A4D; --err:#B3261E;
  --r-lg:22px; --r-md:12px; --r-sm:8px;
  --ease:cubic-bezier(.2,.7,.2,1); --t:.18s;
  --display:"Bricolage Grotesque","Segoe UI",system-ui,sans-serif;
  --body:"Figtree",system-ui,-apple-system,"Segoe UI",sans-serif;
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
html.lock{overflow:hidden}
body{
  margin:0; min-height:100vh; font-family:var(--body); color:var(--on-dark);
  background:
    radial-gradient(900px 520px at 8% -8%, rgba(238,77,45,.16), transparent 60%),
    radial-gradient(900px 600px at 100% 105%, rgba(11,110,138,.22), transparent 60%),
    var(--ink);
  background-attachment:fixed;
  padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  line-height:1.5;
}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
a{color:inherit}
:focus-visible{outline:3px solid #8FB8FF;outline-offset:3px;border-radius:6px}

/* header */
header{padding:22px 0}
.bar{display:flex;align-items:center;justify-content:space-between;gap:12px}
.id{display:flex;align-items:center;gap:12px;font-weight:600}
.mark{width:36px;height:36px;border-radius:50%;background:var(--paper);color:var(--ink);display:grid;place-items:center;font-family:var(--display);font-weight:700;font-size:15px;letter-spacing:-.02em}
.bar small{color:var(--on-dark-muted);font-size:14px}

/* layout */
main{display:grid;gap:36px;padding:16px 0 56px}
.intro h1{font-family:var(--display);font-weight:700;font-size:clamp(2.1rem,6.4vw,3.6rem);line-height:1.02;letter-spacing:-.03em;margin:0 0 18px;max-width:11ch}
.intro p{margin:0 0 10px;color:var(--on-dark-muted);max-width:38ch;font-size:1.05rem}
.intro .hint{color:var(--on-dark);font-weight:500;margin-top:18px}
.stack{display:grid;gap:14px}

/* sheets */
.sheet{background:var(--paper);color:var(--text);border-radius:var(--r-lg);padding:22px;position:relative;overflow:hidden}
.sheet::before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--accent,var(--ink))}
.sheet h2{font-family:var(--display);font-size:1.25rem;margin:0;letter-spacing:-.01em;display:flex;align-items:center;gap:10px;min-height:28px}
.sheet p{margin:0;color:var(--muted);font-size:.95rem}
.logo{height:26px;width:auto;max-width:120px;display:none}
.logo.on{display:block}
.num{font-family:var(--display);font-weight:500;font-size:clamp(1.55rem,6.4vw,2.2rem);letter-spacing:.01em;font-variant-numeric:tabular-nums;margin:14px 0 2px;overflow-wrap:anywhere;line-height:1.15}
.owner{font-weight:600;margin:0 0 2px}
.row{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}
.steps{margin:14px 0 0;padding-left:1.15em;color:var(--muted);font-size:.92rem}
.steps li{margin:3px 0}
.qris{--accent:var(--ink)} .shopee{--accent:var(--shopee)} .bni{--accent:var(--bni)}

.qris-grid{display:grid;grid-template-columns:132px 1fr;gap:18px;align-items:center}
.thumb{all:unset;cursor:zoom-in;display:block;background:#fff;border-radius:var(--r-md);padding:8px;border:1px solid var(--paper-2);aspect-ratio:1;width:132px}
.thumb:focus-visible{outline:3px solid #2457C5}
.thumb img{width:100%;height:100%;object-fit:contain;display:block}
.missing{display:none;font-size:.9rem;color:var(--err);margin-top:10px}
.qris.nofile .missing{display:block}
.qris.nofile .needs-img{display:none}

/* buttons */
.btn{appearance:none;border:1px solid transparent;font:inherit;font-weight:600;font-size:.95rem;min-height:44px;padding:0 16px;border-radius:var(--r-md);display:inline-flex;align-items:center;gap:8px;cursor:pointer;text-decoration:none;background:var(--ink);color:var(--on-dark);transition:background var(--t) var(--ease),transform var(--t) var(--ease),border-color var(--t) var(--ease)}
.btn:hover{background:#242E4A}
.btn:active{transform:scale(.97)}
.btn.ghost{background:transparent;color:var(--text);border-color:#BDB8AC}
.btn.ghost:hover{background:var(--paper-2)}
.btn.done{background:var(--ok);color:#fff;border-color:var(--ok)}
.btn svg{width:18px;height:18px;flex:none}

/* toast */
#toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom));transform:translate(-50%,12px);background:var(--paper);color:var(--text);padding:12px 18px;border-radius:999px;font-weight:600;font-size:.95rem;box-shadow:0 8px 28px rgba(0,0,0,.35);opacity:0;pointer-events:none;transition:opacity var(--t) var(--ease),transform var(--t) var(--ease);max-width:calc(100vw - 32px);text-align:center;z-index:50}
#toast.show{opacity:1;transform:translate(-50%,0)}
#toast.error{background:var(--err);color:#fff}

/* modal */
dialog{border:0;padding:0;background:transparent;max-width:min(92vw,440px);width:100%;max-height:92dvh;color:var(--text);overflow:visible}
dialog::backdrop{background:rgba(6,9,18,.78)}
dialog[open]{animation:pop .2s var(--ease)}
.panel{background:var(--paper);border-radius:var(--r-lg);padding:18px;max-height:92dvh;overflow:auto}
.panel header{padding:0 0 12px;display:flex;justify-content:space-between;align-items:center}
.panel h2{font-family:var(--display);font-size:1.1rem;margin:0}
.close{appearance:none;border:0;background:var(--paper-2);width:44px;height:44px;border-radius:50%;display:grid;place-items:center;cursor:pointer;color:var(--text)}
.close svg{width:20px;height:20px}
.qr-box{background:#fff;border-radius:var(--r-md);padding:20px;border:1px solid var(--paper-2)}
.qr-box img{display:block;width:100%;height:auto;max-height:62dvh;object-fit:contain;margin:0 auto}
.panel .note{font-size:.88rem;color:var(--muted);margin:12px 0 0}

footer{border-top:1px solid var(--line);padding:22px 0 30px;color:var(--on-dark-muted);font-size:.88rem}
footer p{margin:0 0 4px;max-width:60ch}

/* single entrance */
.intro,.sheet{animation:rise .42s var(--ease) both}
.sheet:nth-child(2){animation-delay:.05s}.sheet:nth-child(3){animation-delay:.1s}
@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes pop{from{opacity:0;transform:scale(.97)}to{opacity:1;transform:none}}

@media (min-width:900px){
  .wrap{padding:0 40px}
  main{grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:72px;padding-top:48px;align-items:start}
  .intro{position:sticky;top:32px}
  .sheet{padding:28px 30px}
  .qris-grid{grid-template-columns:168px 1fr}
  .thumb{width:168px}
}
@media (max-width:420px){
  .qris-grid{grid-template-columns:1fr}
  .thumb{width:100%;max-width:200px}
}
@media (hover:hover){.sheet{transition:transform var(--t) var(--ease)}.sheet:hover{transform:translateY(-2px)}}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-copy" viewBox="0 0 24 24"><rect x="9" y="9" width="11" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M5 15V6a2 2 0 0 1 2-2h8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-zoom" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 16l4.5 4.5M11 8.5v5M8.5 11h5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
  <symbol id="i-down" viewBox="0 0 24 24"><path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 20h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-x" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></symbol>
</svg>

<div class="wrap">
  <header>
    <div class="bar">
      <div class="id"><span class="mark" aria-hidden="true">CM</span><span>Charis Maulana</span></div>
      <small>Informasi pembayaran</small>
    </div>
  </header>

  <main>
    <section class="intro" aria-labelledby="judul">
      <h1 id="judul">Kirim pembayaran ke Charis</h1>
      <p>Pilih satu metode di bawah. Pindai QRIS, atau salin nomor tujuan lalu tempel di aplikasi Anda.</p>
      <p>Pastikan nama penerima sesuai sebelum mengonfirmasi.</p>
      <p class="hint">Status pembayaran dicek di aplikasi Anda sendiri.</p>
    </section>

    <div class="stack">
      <!-- QRIS -->
      <article class="sheet qris" id="qris" aria-labelledby="h-qris">
        <div class="qris-grid">
          <button class="thumb needs-img" type="button" id="open-qris" aria-label="Perbesar kode QRIS">
            <img id="qris-thumb" src="qris-charis.png" alt="Kode QRIS Charis Maulana" width="400" height="400" decoding="async">
          </button>
          <div>
            <h2 id="h-qris">QRIS</h2>
            <p>Pindai dari aplikasi bank atau dompet digital apa pun yang mendukung QRIS.</p>
            <div class="row needs-img">
              <button class="btn" type="button" data-open-qris><svg aria-hidden="true"><use href="#i-zoom"/></svg>Perbesar QRIS</button>
              <a class="btn ghost" href="qris-charis.png" download="qris-charis.png"><svg aria-hidden="true"><use href="#i-down"/></svg>Unduh gambar</a>
            </div>
            <p class="missing" role="alert">Gambar QRIS belum ditemukan. Letakkan file <b>qris-charis.png</b> di folder yang sama dengan halaman ini.</p>
          </div>
        </div>
      </article>

      <!-- ShopeePay -->
      <article class="sheet shopee" aria-labelledby="h-shopee">
        <h2 id="h-shopee">
          <img class="logo" data-logo src="assets/shopeepay.svg" alt="" width="120" height="26">
          <span class="wm">ShopeePay</span>
        </h2>
        <p>Kirim ke nomor ShopeePay</p>
        <div class="num" id="num-shopee">0813-3666-3071</div>
        <div class="row">
          <button class="btn" type="button" data-copy="081336663071" data-label="Salin nomor" data-msg="Nomor ShopeePay disalin" data-target="num-shopee">
            <svg aria-hidden="true"><use href="#i-copy"/></svg><span class="lbl">Salin nomor</span>
          </button>
        </div>
        <ol class="steps">
          <li>Salin nomor di atas.</li>
          <li>Buka aplikasi ShopeePay, pilih Kirim, lalu tempel nomornya.</li>
        </ol>
      </article>

      <!-- BNI -->
      <article class="sheet bni" aria-labelledby="h-bni">
        <h2 id="h-bni">
          <img class="logo" data-logo src="assets/bni.svg" alt="" width="120" height="26">
          <span class="wm">Bank Negara Indonesia (BNI)</span>
        </h2>
        <p>Transfer ke rekening</p>
        <div class="num" id="num-bni">0697 9625 88</div>
        <p class="owner" style="color:var(--text);margin-top:4px">a.n. Charis Maulana S A</p>
        <div class="row">
          <button class="btn" type="button" data-copy="0697962588" data-label="Salin rekening" data-msg="Nomor rekening BNI disalin" data-target="num-bni">
            <svg aria-hidden="true"><use href="#i-copy"/></svg><span class="lbl">Salin rekening</span>
          </button>
          <button class="btn ghost" type="button" data-copy="Charis Maulana S A" data-label="Salin nama" data-msg="Nama penerima disalin">
            <svg aria-hidden="true"><use href="#i-copy"/></svg><span class="lbl">Salin nama</span>
          </button>
        </div>
        <ol class="steps">
          <li>Salin nomor rekening.</li>
          <li>Buka aplikasi BNI Mobile Banking atau bank Anda, pilih Transfer, lalu tempel nomornya.</li>
        </ol>
      </article>
    </div>
  </main>

  <footer>
    <p>Halaman ini hanya menampilkan tujuan pembayaran pribadi. Bukan situs resmi ShopeePay atau BNI.</p>
    <p>© <span id="year">2026</span> Charis Maulana</p>
  </footer>
</div>

<div id="toast" role="status" aria-live="polite"></div>

<dialog id="qris-dialog" aria-labelledby="qd-title">
  <div class="panel">
    <header>
      <h2 id="qd-title">QRIS Charis Maulana</h2>
      <button class="close" type="button" id="close-qris" aria-label="Tutup"><svg aria-hidden="true"><use href="#i-x"/></svg></button>
    </header>
    <div class="qr-box"><img id="qris-large" src="qris-charis.png" alt="Kode QRIS Charis Maulana"></div>
    <div class="row">
      <a class="btn" href="qris-charis.png" download="qris-charis.png"><svg aria-hidden="true"><use href="#i-down"/></svg>Unduh gambar</a>
    </div>
    <p class="note">Di ponsel yang sama dengan aplikasi pembayaran? Unduh gambar ini, buka aplikasi Anda, lalu cari opsi untuk memindai atau mengunggah QR dari galeri. Tidak semua aplikasi menyediakan opsi itu.</p>
  </div>
</dialog>

<script>
(function(){
  "use strict";
  var root=document.documentElement;
  document.getElementById("year").textContent=new Date().getFullYear();

  /* Toast: satu elemen, pesan terbaru menggantikan yang lama */
  var toastEl=document.getElementById("toast"),toastTimer;
  function toast(msg,isError){
    clearTimeout(toastTimer);
    toastEl.textContent=msg;
    toastEl.classList.toggle("error",!!isError);
    toastEl.classList.add("show");
    toastTimer=setTimeout(function(){toastEl.classList.remove("show")},2200);
  }

  /* Salin */
  function fallbackCopy(text){
    var ta=document.createElement("textarea");
    ta.value=text;ta.setAttribute("readonly","");
    ta.style.cssText="position:fixed;top:0;left:0;opacity:0";
    document.body.appendChild(ta);ta.select();ta.setSelectionRange(0,text.length);
    var ok=false;try{ok=document.execCommand("copy")}catch(e){}
    document.body.removeChild(ta);
    return ok;
  }
  function copyText(text){
    if(navigator.clipboard&&window.isSecureContext){
      return navigator.clipboard.writeText(text).then(function(){return true},function(){return fallbackCopy(text)});
    }
    return Promise.resolve(fallbackCopy(text));
  }
  function selectNode(id){
    var n=document.getElementById(id);if(!n)return;
    var r=document.createRange();r.selectNodeContents(n);
    var s=getSelection();s.removeAllRanges();s.addRange(r);
  }
  document.querySelectorAll("[data-copy]").forEach(function(btn){
    var lbl=btn.querySelector(".lbl"),use=btn.querySelector("use"),timer;
    btn.addEventListener("click",function(){
      copyText(btn.dataset.copy).then(function(ok){
        if(!ok){
          if(btn.dataset.target)selectNode(btn.dataset.target);
          toast("Tidak bisa menyalin otomatis. Tekan lama angkanya untuk menyalin.",true);
          return;
        }
        clearTimeout(timer);
        btn.classList.add("done");lbl.textContent="Tersalin";use.setAttribute("href","#i-check");
        toast(btn.dataset.msg);
        timer=setTimeout(function(){
          btn.classList.remove("done");lbl.textContent=btn.dataset.label;use.setAttribute("href","#i-copy");
        },1800);
      });
    });
  });

  /* Logo resmi: tampil hanya jika file berhasil dimuat, teks nama sebagai cadangan */
  document.querySelectorAll("[data-logo]").forEach(function(img){
    function show(){
      if(img.naturalWidth>0){img.classList.add("on");var wm=img.parentNode.querySelector(".wm");
        if(wm){wm.style.cssText="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)"}}
    }
    if(img.complete)show();else img.addEventListener("load",show);
  });

  /* QRIS: cek file, lalu modal */
  var qris=document.getElementById("qris"),thumb=document.getElementById("qris-thumb");
  function noFile(){qris.classList.add("nofile")}
  thumb.addEventListener("error",noFile);
  if(thumb.complete&&thumb.naturalWidth===0)noFile();

  var dlg=document.getElementById("qris-dialog"),lastFocus=null;
  function openQris(){
    if(qris.classList.contains("nofile"))return;
    lastFocus=document.activeElement;
    if(typeof dlg.showModal==="function")dlg.showModal();else dlg.setAttribute("open","");
    root.classList.add("lock");
    document.getElementById("close-qris").focus();
  }
  function closeQris(){
    if(typeof dlg.close==="function"&&dlg.open)dlg.close();else dlg.removeAttribute("open");
  }
  dlg.addEventListener("close",function(){
    root.classList.remove("lock");
    if(lastFocus&&lastFocus.focus)lastFocus.focus();
  });
  dlg.addEventListener("click",function(e){if(e.target===dlg)closeQris()});
  document.getElementById("close-qris").addEventListener("click",closeQris);
  document.getElementById("open-qris").addEventListener("click",openQris);
  document.querySelectorAll("[data-open-qris]").forEach(function(b){b.addEventListener("click",openQris)});
  document.addEventListener("keydown",function(e){if(e.key==="Escape"&&dlg.open===undefined&&dlg.hasAttribute("open"))closeQris()});
})();
</script>
</body>
</html>
